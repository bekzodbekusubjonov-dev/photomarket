# ---- Asosiy ----
APP_NAME=PhotoMarket
# Uzun tasodifiy qator qo'ying: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./data/photomarket.db
# PostgreSQL misol: postgresql+psycopg://user:pass@localhost:5432/photomarket
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Email: Google Script (tavsiya, Render uchun) ----
# google-script/Code.gs ni script.google.com ga joylab, veb-ilova manzili va maxfiy kalitni yozing.
MAIL_SCRIPT_URL=
MAIL_SCRIPT_KEY=

# ---- Email (SMTP, ixtiyoriy) ----
# Bo'sh qoldirilsa kodlar faqat terminalga chiqadi (dev rejim).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=sizning@gmail.com,
#        SMTP_PASSWORD=<Google "App password" 16 belgili>, SMTP_FROM="PhotoMarket <sizning@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# ---- Fayllar ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---- Supabase (ixtiyoriy; Render uchun kerak) ----
# DATABASE_URL ni Supabase "Session pooler" manziliga almashtiring:
#   postgresql://postgres.XXXX:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Rasmlar uchun Storage: bucket nomi "uploads" (Public)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# ---- Birinchi admin (ixtiyoriy): backend ishga tushganda yaratadi ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=false
